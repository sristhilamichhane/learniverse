model MCQ {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  options  String[]
  answer   String

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}